<?xml version="1.0" encoding="UTF-8"?>
<!--
  OnePlus 11R (udon / CPH2487) — WORLD-FIRST A12L attempt: Corvus OS 12 (android-12.1.0_r8 base).
  Device/vendor/kernel stack: udon-development @ lineage-20 (July-2023 A13 gen, oldest udon trees in
  existence) adapted down to A12L. Kernel engine: LOS vendor_lineage@lineage-19.1 (kernel.mk task),
  kernel source udon-development@lineage-20 (5.10 GKI).
-->
<manifest>
  <remote name="udon-dev" fetch="https://github.com/udon-development" revision="lineage-20" />
  <remote name="gitlab" fetch="https://gitlab.com" />
  <remote name="los" fetch="https://github.com/LineageOS" />

  <!-- oplus hw -->
  <project name="android_hardware_oplus" path="hardware/oplus" remote="udon-dev" />

  <!-- sm8450-common -->
  <project name="android_device_oneplus_sm8450-common" path="device/oneplus/sm8450-common" remote="udon-dev" />
  <project name="AdarshGrewal/proprietary_vendor_oneplus_sm8450-common" path="vendor/oneplus/sm8450-common" remote="gitlab" revision="lineage-20" />

  <!-- udon -->
  <project name="android_device_oneplus_udon" path="device/oneplus/udon" remote="udon-dev" />
  <project name="AdarshGrewal/proprietary_vendor_oneplus_udon" path="vendor/oneplus/udon" remote="gitlab" revision="lineage-20" />

  <!-- kernel (5.10 GKI source build via vendor_lineage engine) -->
  <project name="android_kernel_oneplus_sm8450" path="kernel/oneplus/sm8450" remote="udon-dev" />

  <!-- HALs: CAF sm8450 @ lineage-20.0-caf-sm8450 + audio stack + fwk-detect -->
  <project name="LineageOS/android_vendor_qcom_opensource_core-utils-sys" path="vendor/qcom/opensource/core-utils-sys" remote="los" revision="lineage-20.0" />
  <project name="LineageOS/android_vendor_qcom_opensource_core-utils-vendor" path="vendor/qcom/opensource/core-utils-vendor" remote="los" revision="lineage-20.0" />
  <project name="android_hardware_qcom_audio" path="hardware/qcom-caf/sm8450/audio" remote="udon-dev" revision="lineage-20.0-caf-sm8450" />
  <project name="android_hardware_qcom_display" path="hardware/qcom-caf/sm8450/display" remote="udon-dev" revision="lineage-20.0-caf-sm8450" />
  <project name="android_hardware_qcom_media" path="hardware/qcom-caf/sm8450/media" remote="udon-dev" revision="lineage-20.0-caf-sm8450" />
  <project name="android_vendor_qcom_opensource_agm" path="vendor/qcom/opensource/agm" remote="udon-dev" />
  <project name="android_vendor_qcom_opensource_audio-hal_st-hal-ar" path="vendor/qcom/opensource/audio-hal/st-hal-ar" remote="udon-dev" />
  <project name="android_vendor_qcom_opensource_pal" path="vendor/qcom/opensource/pal" remote="udon-dev" />

  <!-- kernel-build engine: LOS 19.1 vendor/lineage (kernel.mk task; not inherited into products) -->
  <project name="LineageOS/android_vendor_lineage" path="vendor/lineage" remote="los" revision="lineage-19.1" />
</manifest>
