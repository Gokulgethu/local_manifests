<?xml version="1.0" encoding="UTF-8"?>
<!--
  OnePlus 11R (udon / CPH2487) — Gokulgethu-repo mirror of the PROVEN stack.
  (udon.xml pins rocko upstream directly; this variant uses Gokulgethu's synced repos.)
  Structure: thin udon overlay + rich sm8450-common, udon-specific audio,
  full hardware_oplus AIDL set, kernel + modules + devicetrees (DTB/DTBO chain).
  Retired: CPH2487 mirror, sm8475-common, sm8475 kernel (branches preserve history;
  original Gokul tree state on branch legacy-gokul-20260910 in each repo).
-->
<manifest>
    <!-- Device Trees (Gokul mirrors of the rocko proven stack) -->
    <project name="Gokulgethu/android_device_oneplus_udon"
             path="device/oneplus/udon" remote="github" revision="main" />
    <project name="Gokulgethu/android_device_oneplus_sm8450-common"
             path="device/oneplus/sm8450-common" remote="github" revision="main" />

    <!-- Kernel + modules + device DTs (DTB/DTBO boot chain) -->
    <project name="Gokulgethu/android_kernel_oneplus_sm8450"
             path="kernel/oneplus/sm8450" remote="github" revision="main" />
    <project name="rocko5498/android_kernel_oneplus_sm8450-modules"
             path="kernel/oneplus/sm8450-modules" remote="github" revision="lineage-23.1" />
    <project name="rocko5498/android_kernel_oneplus_sm8450-devicetrees"
             path="kernel/oneplus/sm8450-devicetrees" remote="github" revision="lineage-23.0" />

    <!-- Hardware -->
    <project name="Gokulgethu/android_hardware_oplus"
             path="hardware/oplus" remote="github" revision="main" />
    <project name="Gokulgethu/hardware_dolby"
             path="hardware/dolby" remote="github" revision="main" />

    <!-- Proprietary Vendor Blobs -->
    <project name="Gokulgethu/android_vendor_oneplus_udon"
             path="vendor/oneplus/udon" remote="github" revision="main" />
    <project name="Gokulgethu/android_vendor_oneplus_sm8450-common"
             path="vendor/oneplus/sm8450-common" remote="github" revision="main" />
</manifest>
