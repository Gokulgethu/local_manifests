<?xml version="1.0" encoding="UTF-8"?>
<!--
  OnePlus 11R (udon / CPH2487) — PROVEN device stack (rocko5498) under PixelOS sixteen-qpr2.
  Mirrors rocko5498/local_manifests @ lineage-23.2-udon (post-20260727 NFC rebuild),
  minus his build/soong pin (PixelOS ships its own A16 soong).
  Legacy Gokulgethu tree set preserved in udon-gokul-legacy.xml.
-->
<manifest>
  <remote name="rocko" fetch="https://github.com/rocko5498" />
  <remote name="arman" fetch="https://github.com/Arman-ATI" />
  <remote name="pjgowtham" fetch="https://github.com/pjgowtham" />
  <remote name="icecold" fetch="https://github.com/ICECOLD90191" />
  <remote name="gokul" fetch="https://github.com/Gokulgethu" />

  <!-- CAF audio/common pins (rocko-proven, same lineage-23.2/A16 generation as PixelOS) -->
  <remove-project path="hardware/qcom-caf/sm8450/audio/agm" />
  <project path="hardware/qcom-caf/sm8450/audio/agm"
           name="android_vendor_qcom_opensource_agm"
           remote="rocko"
           revision="e8979ae1d2cf58b2b477ff24f047fa667ec43b11" />

  <remove-project path="hardware/qcom-caf/common" />
  <project path="hardware/qcom-caf/common"
           name="android_hardware_qcom-caf_common"
           remote="rocko"
           revision="006226efcac53a0258b27a9d3a1ab58c0397a14e">
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <linkfile src="os_pickup_sepolicy_vndr.mk" dest="device/qcom/sepolicy_vndr/SEPolicy.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8998/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm845/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450/Android.bp" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/sm8450/audio/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450-6.6/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8550/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
  </project>

  <!-- Device trees (rocko proven) -->
  <project path="device/oneplus/udon"
           name="android_device_oneplus_udon" remote="rocko"
           revision="37bf21edd6dbe18f728d929498524b15f4765e79" />
  <project path="device/oneplus/sm8450-common"
           name="android_device_oneplus_sm8450-common" remote="rocko"
           revision="2ff212ddace121b374e63eb956817422c953f339" />

  <!-- Vendor blobs (rocko proven, NFC-rebuild generation) -->
  <project path="vendor/oneplus/udon"
           name="android_vendor_oneplus_udon" remote="rocko"
           revision="d2b7ad0e82f6e10c21ebbd1949844a273e59711c" />
  <project path="vendor/oneplus/sm8450-common"
           name="proprietary_vendor_oneplus_sm8450-common" remote="rocko"
           revision="b864de7521c0ddce99152a2912c3ca6620149a02" />

  <!-- Kernel + modules + device DTs (rocko/pjgowtham proven) -->
  <project path="kernel/oneplus/sm8450"
           name="android_kernel_oneplus_sm8450" remote="rocko"
           revision="7669ea3eea6dcc83be271add1745bbc858a9809e" />
  <project path="kernel/oneplus/sm8450-modules"
           name="android_kernel_oneplus_sm8450-modules" remote="pjgowtham"
           revision="ca1104519fcb7e769129e75458a9da4833bcc751" />
  <project path="kernel/oneplus/sm8450-devicetrees"
           name="android_kernel_oneplus_sm8450-devicetrees" remote="pjgowtham"
           revision="d8f3eb3fe8f98facd9669aa97d1247f6580e1e58" />

  <!-- Hardware -->
  <project path="hardware/oplus"
           name="android_hardware_oplus" remote="arman"
           revision="45a51fafda4a5cd5aed3321646fdf5bab5421a19" />
  <project path="hardware/dolby"
           name="hardware_dolby" remote="icecold"
           revision="69bb9888e6e36f35d3d2f2d1e67840eefc3433ad" />

  <!-- Use the sm8450 audio primary HAL, not the 6.6/8550/8650/8750 ones -->
  <remove-project path="hardware/qcom-caf/sm8450-6.6/audio/primary-hal" optional="true" />
  <remove-project path="hardware/qcom-caf/sm8550/audio/primary-hal" optional="true" />
  <remove-project path="hardware/qcom-caf/sm8650/audio/primary-hal" optional="true" />
  <remove-project path="hardware/qcom-caf/sm8750/audio/primary-hal" optional="true" />
</manifest>
